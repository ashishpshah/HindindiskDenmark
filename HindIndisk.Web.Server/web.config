<?xml version="1.0" encoding="utf-8"?>
<!--
  Template merged by the Microsoft.NET.Sdk.Web publish pipeline — it inserts the
  <aspNetCore> handler automatically on top of this file rather than generating a
  bare-minimum one from scratch. Hardened against IIS's WebDAV Publishing module
  intercepting non-GET verbs (PUT/DELETE/PATCH), a common recurring cause of spurious
  501/405 responses from ASP.NET Core apps hosted on shared IIS.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
      </handlers>
      <security>
        <requestFiltering>
          <verbs allowUnlisted="true" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
